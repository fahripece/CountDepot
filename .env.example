# Copy this file to .env and fill in your values
# .env is never committed to git

# ── Required ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
PLATFORM_ADMIN_PASSWORD=change-me-too
APP_DOMAIN=yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-smtp-key
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# ── Optional ──────────────────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=you@yourdomain.com
SIGNUP_ENABLED=true
FLASK_ENV=production

# ── Sentry error monitoring ────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_TRACES_SAMPLE_RATE=0.05   # 5% of requests for performance tracing

# ── S3 backups ─────────────────────────────────────────────────────────────────
# IAM permissions needed: s3:PutObject on the bucket
# Cron: 0 2 * * * python scripts/backup.py --s3-bucket $S3_BACKUP_BUCKET
S3_BACKUP_BUCKET=your-backup-bucket-name
S3_BACKUP_PREFIX=countdepot-backups
# AWS credentials (or use an IAM role if running on EC2)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
